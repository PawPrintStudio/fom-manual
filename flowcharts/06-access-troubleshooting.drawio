<mxfile host="app.diagrams.net"><diagram id="06-access-troubleshooting" name="Troubleshooting: badge does not open door"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Troubleshooting: badge does not open door" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="0" width="700" height="50" /></mxCell><mxCell id="e0" value="" edge="1" parent="1" source="s" target="m" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;strokeColor=#546579;endArrow=classic;defaultLabelBackgroundColor=page;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="No" edge="1" parent="1" source="m" target="r" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;strokeColor=#546579;endArrow=classic;defaultLabelBackgroundColor=page;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="Yes" edge="1" parent="1" source="m" target="b" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;strokeColor=#546579;endArrow=classic;defaultLabelBackgroundColor=page;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="No" edge="1" parent="1" source="b" target="usb" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;strokeColor=#546579;endArrow=classic;defaultLabelBackgroundColor=page;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="Yes" edge="1" parent="1" source="b" target="req" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;strokeColor=#546579;endArrow=classic;defaultLabelBackgroundColor=page;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="No / unknown" edge="1" parent="1" source="req" target="net" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;strokeColor=#546579;endArrow=classic;defaultLabelBackgroundColor=page;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="Yes" edge="1" parent="1" source="req" target="pe